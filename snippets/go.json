{
  "function": {
    "prefix": "fn",
    "body": [
      "func ${1:Name}(${2:args}) ${3:error} {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "private function": {
    "prefix": "pfn",
    "body": [
      "func ${1:name}(${2:args}) ${3:error} {",
      "\t$0",
      "}"
    ],
    "description": "unexported function"
  },
  "anonymous function": {
    "prefix": "afn",
    "body": [
      "func(${1:args}) ${2:error} {",
      "\t$0",
      "}"
    ],
    "description": "anonymous function"
  },
  "interface": {
    "prefix": "iface",
    "body": [
      "type ${1:Name} interface {",
      "\t$0",
      "}"
    ],
    "description": "interface"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "type ${1:Name} struct {",
      "\t$0",
      "}"
    ],
    "description": "struct"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "const (",
      "\t${1:First} ${2:int} = iota",
      "\t$0",
      ")"
    ],
    "description": "iota enum"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "${1:name} := ${2:value}"
    ],
    "description": "short variable declaration"
  },
  "constant": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${2:value}"
    ],
    "description": "constant"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "else if ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "else if"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch ${1:expr} {",
      "case ${2:val}:",
      "\t$0",
      "}"
    ],
    "description": "switch"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} := 0; ${1:i} < ${2:n}; ${1:i}++ {",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "for range": {
    "prefix": "forr",
    "body": [
      "for ${1:i}, ${2:v} := range ${3:coll} {",
      "\t$0",
      "}"
    ],
    "description": "for range"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "for ${1:cond} {",
      "\t$0",
      "}"
    ],
    "description": "while"
  },
  "panic": {
    "prefix": "throw",
    "body": [
      "panic(${1:err})"
    ],
    "description": "panic"
  },
  "defer": {
    "prefix": "defer",
    "body": [
      "defer ${1:fn}($0)"
    ],
    "description": "defer"
  },
  "import": {
    "prefix": "imp",
    "body": [
      "import (",
      "\t\"${1:pkg}\"",
      ")"
    ],
    "description": "import"
  },
  "print": {
    "prefix": "log",
    "body": [
      "fmt.Println(${1:\"msg\"})"
    ],
    "description": "print line"
  },
  "print var": {
    "prefix": "logv",
    "body": [
      "fmt.Printf(\"${1:v} = %+v\\n\", ${1:v})"
    ],
    "description": "print variable"
  },
  "printf": {
    "prefix": "logf",
    "body": [
      "fmt.Printf(\"${1:format}\\n\"${2:, args})"
    ],
    "description": "formatted print"
  },
  "return": {
    "prefix": "ret",
    "body": [
      "return ${0}"
    ],
    "description": "return"
  },
  "test": {
    "prefix": "test",
    "body": [
      "func Test${1:Name}(t *testing.T) {",
      "\t$0",
      "}"
    ],
    "description": "test function"
  }
}
