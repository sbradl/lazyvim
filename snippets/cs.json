{
  "method": {
    "prefix": "fn",
    "body": [
      "public ${1:void} ${2:Name}(${3:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "method"
  },
  "private method": {
    "prefix": "pfn",
    "body": [
      "private ${1:void} ${2:Name}(${3:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "private method"
  },
  "lambda": {
    "prefix": "afn",
    "body": [
      "(${1:args}) => ${0:expr}"
    ],
    "description": "lambda"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "public ${1:ClassName}(${2:args})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "constructor"
  },
  "class": {
    "prefix": "cls",
    "body": [
      "public class ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "class"
  },
  "interface": {
    "prefix": "iface",
    "body": [
      "public interface I${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "interface"
  },
  "struct": {
    "prefix": "struct",
    "body": [
      "public struct ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "struct"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "public enum ${1:Name}",
      "{",
      "\t$0",
      "}"
    ],
    "description": "enum"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "var ${1:name} = ${2:value};"
    ],
    "description": "variable"
  },
  "private field": {
    "prefix": "pvar",
    "body": [
      "private ${1:type} _${2:name};"
    ],
    "description": "private field"
  },
  "constant": {
    "prefix": "const",
    "body": [
      "const ${1:type} ${2:NAME} = ${3:value};"
    ],
    "description": "constant"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:cond})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if (${1:cond})",
      "{",
      "\t$2",
      "}",
      "else",
      "{",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "else if (${1:cond})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "else if"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:expr})",
      "{",
      "\tcase ${2:val}:",
      "\t\t$0",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "switch"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (int ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++)",
      "{",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "foreach": {
    "prefix": "forr",
    "body": [
      "foreach (var ${1:item} in ${2:collection})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "foreach"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while (${1:cond})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "while"
  },
  "try": {
    "prefix": "try",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (${2:Exception} ${3:ex})",
      "{",
      "\t$0",
      "}"
    ],
    "description": "try / catch"
  },
  "try finally": {
    "prefix": "tryf",
    "body": [
      "try",
      "{",
      "\t$1",
      "}",
      "catch (${2:Exception} ${3:ex})",
      "{",
      "\t$4",
      "}",
      "finally",
      "{",
      "\t$0",
      "}"
    ],
    "description": "try / catch / finally"
  },
  "throw": {
    "prefix": "throw",
    "body": [
      "throw new ${1:Exception}(${2:\"message\"});"
    ],
    "description": "throw"
  },
  "using": {
    "prefix": "imp",
    "body": [
      "using ${1:Namespace};"
    ],
    "description": "using directive"
  },
  "print": {
    "prefix": "log",
    "body": [
      "Console.WriteLine(${1:\"msg\"});"
    ],
    "description": "print line"
  },
  "print var": {
    "prefix": "logv",
    "body": [
      "Console.WriteLine(\\$\"${1:v} = {${1:v}}\");"
    ],
    "description": "print variable"
  },
  "printf": {
    "prefix": "logf",
    "body": [
      "Console.WriteLine(${1:\"{0}\"}, ${2:args});"
    ],
    "description": "formatted print"
  },
  "return": {
    "prefix": "ret",
    "body": [
      "return ${0};"
    ],
    "description": "return"
  },
  "test": {
    "prefix": "test",
    "body": [
      "[Fact]",
      "public void ${1:Name}()",
      "{",
      "\t$0",
      "}"
    ],
    "description": "xUnit test"
  },
  "suite": {
    "prefix": "suite",
    "body": [
      "public class ${1:Name}Tests",
      "{",
      "\t$0",
      "}"
    ],
    "description": "test class"
  }
}
