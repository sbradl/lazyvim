{
  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:name}(${2:args})",
      "\t$0",
      "end"
    ],
    "description": "function"
  },
  "local function": {
    "prefix": "pfn",
    "body": [
      "local function ${1:name}(${2:args})",
      "\t$0",
      "end"
    ],
    "description": "local function"
  },
  "anonymous function": {
    "prefix": "afn",
    "body": [
      "function(${1:args})",
      "\t$0",
      "end"
    ],
    "description": "anonymous function"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "function ${1:Class}.new(${2:args})",
      "\tlocal self = setmetatable({}, ${1:Class})",
      "\t$0",
      "\treturn self",
      "end"
    ],
    "description": "constructor"
  },
  "class": {
    "prefix": "cls",
    "body": [
      "local ${1:Name} = {}",
      "${1:Name}.__index = ${1:Name}",
      "$0"
    ],
    "description": "class table"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "local ${1:name} = ${2:value}"
    ],
    "description": "local variable"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} then",
      "\t$0",
      "end"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} then",
      "\t$2",
      "else",
      "\t$0",
      "end"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "elseif ${1:cond} then",
      "\t$0"
    ],
    "description": "elseif"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} = ${2:1}, ${3:n} do",
      "\t$0",
      "end"
    ],
    "description": "numeric for"
  },
  "for ipairs": {
    "prefix": "forr",
    "body": [
      "for ${1:i}, ${2:v} in ipairs(${3:t}) do",
      "\t$0",
      "end"
    ],
    "description": "for ipairs"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while ${1:cond} do",
      "\t$0",
      "end"
    ],
    "description": "while"
  },
  "pcall": {
    "prefix": "try",
    "body": [
      "local ok, err = pcall(function()",
      "\t$0",
      "end)"
    ],
    "description": "protected call"
  },
  "error": {
    "prefix": "throw",
    "body": [
      "error(${1:\"message\"})"
    ],
    "description": "error"
  },
  "require": {
    "prefix": "imp",
    "body": [
      "local ${1:mod} = require(\"${2:module}\")"
    ],
    "description": "require"
  },
  "print": {
    "prefix": "log",
    "body": [
      "print(${1:\"msg\"})"
    ],
    "description": "print"
  },
  "print var": {
    "prefix": "logv",
    "body": [
      "print(\"${1:v} =\", ${1:v})"
    ],
    "description": "print variable"
  },
  "return": {
    "prefix": "ret",
    "body": [
      "return ${0}"
    ],
    "description": "return"
  }
}
