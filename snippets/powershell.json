{
  "function": {
    "prefix": "fn",
    "body": [
      "function ${1:Verb-Noun} {",
      "\t[CmdletBinding()]",
      "\tparam(",
      "\t\t$2",
      "\t)",
      "\t$0",
      "}"
    ],
    "description": "advanced function"
  },
  "hidden method": {
    "prefix": "pfn",
    "body": [
      "hidden [${1:void}] ${2:Name}(${3:args}) {",
      "\t$0",
      "}"
    ],
    "description": "hidden class method"
  },
  "scriptblock": {
    "prefix": "afn",
    "body": [
      "{ param(${1:args}) $0 }"
    ],
    "description": "scriptblock"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "${1:ClassName}(${2:args}) {",
      "\t$0",
      "}"
    ],
    "description": "constructor"
  },
  "class": {
    "prefix": "cls",
    "body": [
      "class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "class"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "enum"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "\\$${1:name} = ${2:value}"
    ],
    "description": "variable"
  },
  "hidden field": {
    "prefix": "pvar",
    "body": [
      "hidden [${1:type}] \\$${2:name}"
    ],
    "description": "hidden field"
  },
  "constant": {
    "prefix": "const",
    "body": [
      "Set-Variable -Name ${1:name} -Value ${2:value} -Option Constant"
    ],
    "description": "constant"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if (${1:cond}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "elseif (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "elseif"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:expr}) {",
      "\t${2:value} { $0 }",
      "\tdefault { }",
      "}"
    ],
    "description": "switch"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (\\$${1:i} = 0; \\$${1:i} -lt ${2:n}; \\$${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "foreach": {
    "prefix": "forr",
    "body": [
      "foreach (\\$${1:item} in ${2:collection}) {",
      "\t$0",
      "}"
    ],
    "description": "foreach"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "while"
  },
  "try": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch {",
      "\t$0",
      "}"
    ],
    "description": "try / catch"
  },
  "try finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "\t$1",
      "} catch {",
      "\t$2",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "try / catch / finally"
  },
  "throw": {
    "prefix": "throw",
    "body": [
      "throw ${1:\"message\"}"
    ],
    "description": "throw"
  },
  "import module": {
    "prefix": "imp",
    "body": [
      "Import-Module ${1:Name}"
    ],
    "description": "import module"
  },
  "write host": {
    "prefix": "log",
    "body": [
      "Write-Host ${1:\"msg\"}"
    ],
    "description": "print line"
  },
  "write host var": {
    "prefix": "logv",
    "body": [
      "Write-Host \"${1:v} = \\$${1:v}\""
    ],
    "description": "print variable"
  },
  "format": {
    "prefix": "logf",
    "body": [
      "Write-Host (\"${1:format}\" -f ${2:args})"
    ],
    "description": "formatted print"
  },
  "return": {
    "prefix": "ret",
    "body": [
      "return ${0}"
    ],
    "description": "return"
  }
}
