{
  "if": {
    "prefix": "if",
    "body": [
      "<%= if ${1:cond} do %>",
      "\t$0",
      "<% end %>"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "<%= if ${1:cond} do %>",
      "\t$2",
      "<% else %>",
      "\t$0",
      "<% end %>"
    ],
    "description": "if / else"
  },
  "for": {
    "prefix": "for",
    "body": [
      "<%= for ${1:x} <- ${2:enum} do %>",
      "\t$0",
      "<% end %>"
    ],
    "description": "comprehension"
  },
  "for attr": {
    "prefix": "forr",
    "body": [
      "<${1:div} :for={${2:x} <- ${3:enum}}>",
      "\t$0",
      "</${1:div}>"
    ],
    "description": ":for attribute"
  }
}
