{
  "def": {
    "prefix": "fn",
    "body": [
      "def ${1:name}(${2:args}) do",
      "\t$0",
      "end"
    ],
    "description": "public function"
  },
  "defp": {
    "prefix": "pfn",
    "body": [
      "defp ${1:name}(${2:args}) do",
      "\t$0",
      "end"
    ],
    "description": "private function"
  },
  "anonymous function": {
    "prefix": "afn",
    "body": [
      "fn ${1:args} ->",
      "\t$0",
      "end"
    ],
    "description": "anonymous function"
  },
  "defmodule": {
    "prefix": "cls",
    "body": [
      "defmodule ${1:Name} do",
      "\t$0",
      "end"
    ],
    "description": "module"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "${1:name} = ${2:value}"
    ],
    "description": "binding"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:cond} do",
      "\t$0",
      "end"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:cond} do",
      "\t$2",
      "else",
      "\t$0",
      "end"
    ],
    "description": "if / else"
  },
  "case": {
    "prefix": "sw",
    "body": [
      "case ${1:expr} do",
      "\t${2:pattern} ->",
      "\t\t$0",
      "end"
    ],
    "description": "case"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:x} <- ${2:enum} do",
      "\t$0",
      "end"
    ],
    "description": "comprehension"
  },
  "Enum.each": {
    "prefix": "forr",
    "body": [
      "Enum.each(${1:enum}, fn ${2:x} ->",
      "\t$0",
      "end)"
    ],
    "description": "Enum.each"
  },
  "raise": {
    "prefix": "throw",
    "body": [
      "raise ${1:\"message\"}"
    ],
    "description": "raise"
  },
  "alias": {
    "prefix": "imp",
    "body": [
      "alias ${1:Module}"
    ],
    "description": "alias"
  },
  "IO.puts": {
    "prefix": "log",
    "body": [
      "IO.puts(${1:\"msg\"})"
    ],
    "description": "print line"
  },
  "IO.inspect": {
    "prefix": "logv",
    "body": [
      "IO.inspect(${1:v}, label: \"${1:v}\")"
    ],
    "description": "inspect variable"
  },
  "test": {
    "prefix": "test",
    "body": [
      "test \"${1:description}\" do",
      "\t$0",
      "end"
    ],
    "description": "ExUnit test"
  },
  "describe": {
    "prefix": "suite",
    "body": [
      "describe \"${1:name}\" do",
      "\t$0",
      "end"
    ],
    "description": "describe block"
  },
  "guard": {
    "prefix": "guard",
    "body": [
      "when is_${1:binary}(${2:arg})"
    ],
    "description": "guard clause"
  }
}
