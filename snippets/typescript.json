{
  "method": {
    "prefix": "fn",
    "body": [
      "${1:name}(${2:args}): ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "method"
  },
  "private method": {
    "prefix": "pfn",
    "body": [
      "private ${1:name}(${2:args}): ${3:void} {",
      "\t$0",
      "}"
    ],
    "description": "private method"
  },
  "arrow function": {
    "prefix": "afn",
    "body": [
      "(${1:args}) => ${0}"
    ],
    "description": "arrow function"
  },
  "constructor": {
    "prefix": "ctor",
    "body": [
      "constructor(${1:args}) {",
      "\t$0",
      "}"
    ],
    "description": "constructor"
  },
  "class": {
    "prefix": "cls",
    "body": [
      "class ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "class"
  },
  "interface": {
    "prefix": "iface",
    "body": [
      "interface ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "interface"
  },
  "enum": {
    "prefix": "enum",
    "body": [
      "enum ${1:Name} {",
      "\t$0",
      "}"
    ],
    "description": "enum"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "let ${1:name} = ${2:value};"
    ],
    "description": "variable"
  },
  "private field": {
    "prefix": "pvar",
    "body": [
      "private ${1:name}: ${2:type};"
    ],
    "description": "private field"
  },
  "constant": {
    "prefix": "const",
    "body": [
      "const ${1:name} = ${2:value};"
    ],
    "description": "constant"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if (${1:cond}) {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "else if (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "else if"
  },
  "switch": {
    "prefix": "sw",
    "body": [
      "switch (${1:expr}) {",
      "\tcase ${2:val}:",
      "\t\t$0",
      "\t\tbreak;",
      "\tdefault:",
      "\t\tbreak;",
      "}"
    ],
    "description": "switch"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for (let ${1:i} = 0; ${1:i} < ${2:n}; ${1:i}++) {",
      "\t$0",
      "}"
    ],
    "description": "for loop"
  },
  "for of": {
    "prefix": "forr",
    "body": [
      "for (const ${1:item} of ${2:iterable}) {",
      "\t$0",
      "}"
    ],
    "description": "for ... of"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while (${1:cond}) {",
      "\t$0",
      "}"
    ],
    "description": "while"
  },
  "try": {
    "prefix": "try",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:err}) {",
      "\t$0",
      "}"
    ],
    "description": "try / catch"
  },
  "try finally": {
    "prefix": "tryf",
    "body": [
      "try {",
      "\t$1",
      "} catch (${2:err}) {",
      "\t$3",
      "} finally {",
      "\t$0",
      "}"
    ],
    "description": "try / catch / finally"
  },
  "throw": {
    "prefix": "throw",
    "body": [
      "throw new ${1:Error}(${2:\"message\"});"
    ],
    "description": "throw"
  },
  "import": {
    "prefix": "imp",
    "body": [
      "import { ${1:member} } from \"${2:module}\";"
    ],
    "description": "import"
  },
  "export": {
    "prefix": "exp",
    "body": [
      "export ${0}"
    ],
    "description": "export"
  },
  "log": {
    "prefix": "log",
    "body": [
      "console.log(${1:\"msg\"});"
    ],
    "description": "console.log"
  },
  "log var": {
    "prefix": "logv",
    "body": [
      "console.log(\"${1:v} =\", ${1:v});"
    ],
    "description": "log variable"
  },
  "logf": {
    "prefix": "logf",
    "body": [
      "console.log(`${1:msg}`);"
    ],
    "description": "template log"
  },
  "return": {
    "prefix": "ret",
    "body": [
      "return ${0};"
    ],
    "description": "return"
  },
  "test": {
    "prefix": "test",
    "body": [
      "it(\"${1:should}\", () => {",
      "\t$0",
      "});"
    ],
    "description": "test case"
  },
  "suite": {
    "prefix": "suite",
    "body": [
      "describe(\"${1:name}\", () => {",
      "\t$0",
      "});"
    ],
    "description": "describe block"
  }
}
