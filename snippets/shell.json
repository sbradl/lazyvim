{
  "function": {
    "prefix": "fn",
    "body": [
      "${1:name}() {",
      "\t$0",
      "}"
    ],
    "description": "function"
  },
  "variable": {
    "prefix": "var",
    "body": [
      "${1:name}=${2:value}"
    ],
    "description": "variable"
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition}; then",
      "\t$0",
      "fi"
    ],
    "description": "if"
  },
  "if else": {
    "prefix": "ife",
    "body": [
      "if ${1:condition}; then",
      "\t$2",
      "else",
      "\t$0",
      "fi"
    ],
    "description": "if / else"
  },
  "else if": {
    "prefix": "eif",
    "body": [
      "elif ${1:condition}; then",
      "\t$0"
    ],
    "description": "elif"
  },
  "case": {
    "prefix": "sw",
    "body": [
      "case ${1:expr} in",
      "\t${2:pattern})",
      "\t\t$0",
      "\t\t;;",
      "esac"
    ],
    "description": "case"
  },
  "for": {
    "prefix": "for",
    "body": [
      "for ${1:i} in ${2:list}; do",
      "\t$0",
      "done"
    ],
    "description": "for loop"
  },
  "for array": {
    "prefix": "forr",
    "body": [
      "for ${1:item} in \"\\${${2:array}[@]}\"; do",
      "\t$0",
      "done"
    ],
    "description": "iterate array"
  },
  "while": {
    "prefix": "wh",
    "body": [
      "while ${1:condition}; do",
      "\t$0",
      "done"
    ],
    "description": "while"
  },
  "echo": {
    "prefix": "log",
    "body": [
      "echo ${1:\"msg\"}"
    ],
    "description": "echo"
  },
  "echo var": {
    "prefix": "logv",
    "body": [
      "echo \"${1:v} = \\$${1:v}\""
    ],
    "description": "echo variable"
  },
  "printf": {
    "prefix": "logf",
    "body": [
      "printf '${1:%s}\\n' ${2:args}"
    ],
    "description": "printf"
  }
}
